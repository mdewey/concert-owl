[Unit]
Description=Concert Owl — weekly summary post
Documentation=https://github.com/mdewey/concert-owl
# Don't fire until the network is actually up (the scraper + Slack need it).
After=network-online.target
Wants=network-online.target
# On failure, hand the (suffix-less) unit name to the alert service.
OnFailure=concert-owl-alert@%N.service

[Service]
Type=oneshot
User=dewey
WorkingDirectory=/home/dewey/projects/concert-owl
ExecStart=/home/dewey/.nvm/versions/node/v21.7.1/bin/node --env-file=/home/dewey/projects/concert-owl/.env /home/dewey/projects/concert-owl/scripts/weekly.v2.js
