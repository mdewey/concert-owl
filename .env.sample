SLACK_URL='https://some/hooks/slack/url'
WEEKLY_SLACK_URL='https://some/hooks/slack/url'
# Webhook for the new Spotify-vibe recommendations channel.
RECOMMENDATIONS_SLACK_URL='https://some/hooks/slack/url'
# Webhook for the errors channel (systemd OnFailure alerts post here).
ERROR_SLACK_URL='https://some/hooks/slack/url'
GEMINI_API_KEY="some key"

# --- Spotify (vibe recommendations) ---
# Client Credentials flow only (public data); no user OAuth/refresh token.
# Create an app at https://developer.spotify.com/dashboard to get id/secret.
SPOTIFY_CLIENT_ID='some id'
SPOTIFY_CLIENT_SECRET='some secret'
# A PUBLIC playlist that represents your current vibe (id or full URL).
SPOTIFY_PLAYLIST_ID='https://open.spotify.com/playlist/xxxxxxxxxxxxxxxxxxxxxx'

# --- Datastore ---
# Optional: override where the JSON store lives (defaults to ./data/shows.json)
# JSON_STORE_PATH='./data/shows.json'
