{
  "name": "concert-owl",
  "version": "2.0.0",
  "type": "module",
  "description": "A Node.js application for tracking and managing concert events.",
  "main": "index.js",
  "scripts": {
    "weekly:v2": "node --env-file=.env scripts/weekly.v2.js",
    "upcoming:v2": "node --env-file=.env scripts/upcoming.v2.js",
    "recommend:v2": "node --env-file=.env scripts/recommend.v2.js",
    "recommend:v2:dry": "node --env-file=.env scripts/recommend.v2.js --dry-run",
    "release-radar": "node --env-file=.env scripts/release-radar.js",
    "release-radar:dry": "node --env-file=.env scripts/release-radar.js --dry-run",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test-coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint ."
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "eslint": "^8.36.0",
    "eslint-config-google": "^0.14.0",
    "jest": "^29.5.0"
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
    "axios": "^1.3.4",
    "cheerio": "^1.0.0-rc.12",
    "date-fns": "^2.29.3",
    "date-fns-tz": "^1.3.6",
    "dotenv": "^16.4.7",
    "node-fetch": "^2.6.6",
    "node-html-parser": "^6.1.5",
    "uuid": "^9.0.0"
  }
}